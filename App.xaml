<Application
    x:Class="RhythmHub.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Gamer Dark Mode Color Palette -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D0D11"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#16161D"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF3366"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0B0"/>
            
            <Style TargetType="TextBlock" x:Key="GamerTitleStyle">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontWeight" Value="Black"/>
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
