<Window
    x:Class="RhythmHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:RhythmHub.ViewModels"
    Title="RhythmHub">

    <Grid Background="{StaticResource WindowBackgroundBrush}" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation / Action Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" Padding="20,15" BorderThickness="0,0,0,1" BorderBrush="#2A2A35">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="RHYTHM HUB" Style="{StaticResource GamerTitleStyle}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="Connect Custom..." Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="10" Width="200">
                                    <TextBlock Text="Manual Connection" FontWeight="Bold"/>
                                    <TextBox Header="Vendor ID (Hex)" Text="{x:Bind ViewModel.CustomVid, Mode=TwoWay}" PlaceholderText="e.g. 1430"/>
                                    <TextBox Header="Product ID (Hex)" Text="{x:Bind ViewModel.CustomPid, Mode=TwoWay}" PlaceholderText="e.g. 0715"/>
                                    <TextBox Header="Device Name" Text="{x:Bind ViewModel.CustomName, Mode=TwoWay}" PlaceholderText="My Custom Guitar"/>
                                    <Button Content="Connect" Command="{x:Bind ViewModel.ConnectManualCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    
                    <Button Content="Diagnostics" Background="Transparent" BorderBrush="#3A3A45">
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxHeight="400" MaxWidth="600">
                                    <TextBlock Text="{x:Bind ViewModel.DiagnosticLog, Mode=OneWay}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Content="Restart System" Command="{x:Bind ViewModel.RestartAppCommand}" Background="Transparent" BorderBrush="#3A3A45"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            
            <!-- Empty State -->
            <StackPanel Visibility="{x:Bind ViewModel.IsEmptyState, Mode=OneWay}" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                <TextBlock Text="NO DONGLES DETECTED" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Plug in a receiver or manually connect a custom instrument above." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Grid of Cards -->
            <GridView Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.ConnectedDevices}"
                      SelectionMode="None"
                      Padding="40"
                      HorizontalAlignment="Stretch">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:DeviceViewModel">
                        <Border Background="{StaticResource CardBackgroundBrush}" 
                                CornerRadius="8" 
                                Padding="20" 
                                Margin="10" 
                                Width="320" 
                                MinHeight="220"
                                BorderThickness="1"
                                BorderBrush="#2A2A35">
                            <Border.Shadow>
                                <ThemeShadow/>
                            </Border.Shadow>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Icon + Title + Protocol -->
                                <StackPanel Grid.Row="0" Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind DeviceName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Background="#2D2D38" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="34,0,0,0">
                                        <TextBlock Text="{x:Bind ProtocolName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Status -->
                                <StackPanel Grid.Row="1" Spacing="8" Margin="0,20,0,20">
                                    <TextBlock Text="STATUS" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" CharacterSpacing="50"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="12" Height="12" Fill="{x:Bind StatusColor, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind ConnectionStatus, Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind SyncInstruction, Mode=OneWay}" 
                                               Visibility="{x:Bind SyncInstructionVisibility, Mode=OneWay}" 
                                               Foreground="{StaticResource AccentBrush}" 
                                               FontSize="12" 
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Row="2" Spacing="8">
                                    <Button Content="Revert to Default Driver" 
                                            Command="{x:Bind RevertDriverCommand}" 
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind RevertDriverVisibility, Mode=OneWay}"
                                            Background="#2D2D38" BorderBrush="#444455"
                                            HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="Restore factory Microsoft Xbox driver"/>

                                    <Button Content="Switch to WinUSB Driver" 
                                            Command="{x:Bind SwitchToWinUsbCommand}" 
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind SwitchToWinUsbVisibility, Mode=OneWay}"
                                            Background="#0078D4" Foreground="White" BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="Install WinUSB driver to use RhythmHub's built-in mapper"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            
            <!-- USB Hotplug Notification Banner -->
            <InfoBar Grid.Row="1" 
                     IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
                     Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                     VerticalAlignment="Bottom" 
                     HorizontalAlignment="Center"
                     Margin="20"
                     CornerRadius="8"
                     Width="400">
                <InfoBar.Shadow>
                    <ThemeShadow/>
                </InfoBar.Shadow>
            </InfoBar>

        </Grid>
    </Grid>
</Window>
