<Window
    x:Class="RhythmHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:RhythmHub.ViewModels"
    Title="RhythmHub">

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation / Action Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" Padding="20,15" BorderThickness="0,0,0,1" BorderBrush="#2A2A35">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="RHYTHM HUB" Style="{StaticResource GamerTitleStyle}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Content="Connect Custom..." Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="10" Width="200">
                                    <TextBlock Text="Manual Connection" FontWeight="Bold"/>
                                    <TextBox Header="Vendor ID (Hex)" Text="{x:Bind ViewModel.CustomVid, Mode=TwoWay}" PlaceholderText="e.g. 1430"/>
                                    <TextBox Header="Product ID (Hex)" Text="{x:Bind ViewModel.CustomPid, Mode=TwoWay}" PlaceholderText="e.g. 0715"/>
                                    <TextBox Header="Device Name" Text="{x:Bind ViewModel.CustomName, Mode=TwoWay}" PlaceholderText="My Custom Guitar"/>
                                    <Button Content="Connect" Command="{x:Bind ViewModel.ConnectManualCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    
                    <Button Content="Diagnostics" Background="Transparent" BorderBrush="#3A3A45">
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxHeight="400" MaxWidth="600">
                                    <TextBlock Text="{x:Bind ViewModel.DiagnosticLog, Mode=OneWay}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Content="Restart System" Command="{x:Bind ViewModel.RestartAppCommand}" Background="Transparent" BorderBrush="#3A3A45"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            
            <!-- Empty State -->
            <StackPanel Visibility="{x:Bind ViewModel.IsEmptyState, Mode=OneWay}" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                <TextBlock Text="NO DONGLES DETECTED" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Plug in a receiver or manually connect a custom instrument above." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Master-Detail Layout -->
            <Grid Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar (Master) -->
                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#2A2A35" Background="#111116">
                    <ListView ItemsSource="{x:Bind ViewModel.ConnectedDevices}" 
                              SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                              Margin="0,10,0,0"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:DeviceViewModel">
                                <StackPanel Padding="10,5">
                                    <TextBlock Text="{x:Bind DeviceName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind ConnectionStatus, Mode=OneWay}" FontSize="12" Foreground="{x:Bind StatusColor, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- Detail View -->
                <Grid Grid.Column="1" Padding="40" Visibility="{x:Bind ViewModel.IsDeviceSelected, Mode=OneWay}" DataContext="{x:Bind ViewModel.SelectedDevice, Mode=OneWay}">
                    <StackPanel Spacing="20">
                        <!-- We just bind directly since DataContext is set, but x:Bind requires casting or specific paths. 
                             Using standard Binding here for simplicity since DataContext changes -->
                        <TextBlock Text="{Binding DeviceName}" FontSize="36" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="DEVICE STATUS" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="16" Height="16" Fill="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SyncInstruction}" Visibility="{Binding SyncInstructionVisibility}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"/>

                                <Button Content="Revert to Default Driver" 
                                        Command="{x:Bind ViewModel.RevertXboxDriverCommand}" 
                                        Visibility="{Binding RevertDriverVisibility}"
                                        Background="#2D2D38" BorderBrush="#444455" Margin="0,10,0,0"
                                        ToolTipService.ToolTip="Restore factory Microsoft Xbox driver (lights up dongle, native input)"/>

                                <Button Content="Switch to WinUSB Driver" 
                                        Command="{x:Bind ViewModel.SwitchToWinUsbDriverCommand}" 
                                        Visibility="{Binding SwitchToWinUsbVisibility}"
                                        Background="#0078D4" Foreground="White" BorderThickness="0" Margin="0,10,0,0"
                                        ToolTipService.ToolTip="Install WinUSB driver to use RhythmHub's built-in mapper"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
            
            <!-- USB Hotplug Notification Banner -->
            <InfoBar Grid.Row="1" 
                     IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
                     Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                     VerticalAlignment="Bottom" 
                     HorizontalAlignment="Center"
                     Margin="20"
                     CornerRadius="8"
                     Width="400">
                <InfoBar.Shadow>
                    <ThemeShadow/>
                </InfoBar.Shadow>
            </InfoBar>

        </Grid>
    </Grid>
</Window>
